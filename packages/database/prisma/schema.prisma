datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum LeaveType {
  ANNUAL
  PERSONAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAction {
  SUBMITTED
  UPDATED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id             String          @id @default(cuid())
  displayName    String
  legalName      String
  pinHash        String
  role           Role            @default(STAFF)
  status         UserStatus      @default(PENDING)
  employmentType EmploymentType?
  contactNumber  String?
  email          String?         @unique
  passwordHash   String?
  phone          String?         @unique   // E.164, e.g. +61412345678; used for sign-in

  shifts    Shift[]
  payRates  PayRate[]
  staffSessions StaffSession[]
  shiftAudits ShiftAudit[] @relation("ShiftAuditActor")
  leaveRequests LeaveRequest[] @relation("LeaveRequester")
  leaveDecisions LeaveRequest[] @relation("LeaveReviewer")
  leaveEvents LeaveEvent[] @relation("LeaveEventActor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, displayName])

  approvedAt     DateTime? @db.Timestamptz(3)
  approvedById   String?
  approvedBy     User?     @relation("UserApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedUsers  User[]    @relation("UserApprover")
}

model StaffSession {
  tokenHash        String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialDigest String
  expiresAt        DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model StaffLoginWindow {
  key       String   @id
  attempts  Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model Shift {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  clockIn           DateTime  @default(now()) @db.Timestamptz(3)
  clockOut          DateTime? @db.Timestamptz(3)
  clockInRequestId  String    @unique @db.Uuid
  clockOutRequestId String?   @unique @db.Uuid
  edited            Boolean   @default(false)
  note              String?
  audits            ShiftAudit[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, clockOut])
  @@index([clockIn])
}

model PayRate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  hourlyRate    Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
}

model ShiftAudit {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User     @relation("ShiftAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  before    Json?
  after     Json
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([shiftId, createdAt])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Restrict)
  type          LeaveType
  status        LeaveStatus @default(PENDING)
  allDay        Boolean
  startsAt      DateTime    @db.Timestamptz(3)
  endsAt        DateTime    @db.Timestamptz(3)
  returnDate    DateTime    @db.Date
  returnTime    String?
  reason        String
  requestId     String      @unique @db.Uuid
  version       Int         @default(1)
  reviewerId    String?
  reviewer      User?       @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decisionNote  String?
  decidedAt     DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  events        LeaveEvent[]
  @@index([userId, startsAt])
  @@index([status, startsAt])
}

model LeaveEvent {
  id        String       @id @default(cuid())
  leaveId   String
  leave     LeaveRequest @relation(fields: [leaveId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User         @relation("LeaveEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    LeaveAction
  before    Json?
  after     Json
  note      String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  @@index([leaveId, createdAt])
  }


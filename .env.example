# Local commands load this file's values from a private root .env.
# Use the Neon dev branch locally, not production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Temporary timer registration setting. Disable before public rollout.
AUTO_APPROVE_STAFF="false"

# Development hostnames only, no scheme or port.
ALLOWED_DEV_ORIGINS=""
# Exact additional external origins, including scheme and port, if required.
ADDITIONAL_ALLOWED_ORIGINS=""
